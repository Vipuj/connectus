      "required": [
        "uid",
        "role",
        "displayName",
        "email",
        "course",
        "branch",
        "semester",
        "year",
        "collegeId",
        "collegeVerified",
        "areaId",
        "radiusKm",
        "interests",
        "followedCollegeIds",
        "onboardingCompleted",
        "consentAccepted",
        "createdAt",
        "updatedAt"
      ]
