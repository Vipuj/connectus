  "firestore": {
    "/studentProfiles/{userId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Private student profile documents keyed by Firebase Auth UID."
    },
    "/organizerApplications/{userId}": {
      "schema": { "$ref": "#/entities/OrganizerApplication" },
      "description": "External partner verification requests keyed by applicant UID, locked to pending until Campus Official approval."
    },
    "/officialMemberships/{userId}": {
      "schema": { "$ref": "#/entities/OfficialMembership" },
      "description": "Active official members (verified college officials and invited club leaders) keyed by Firebase Auth UID."
    },
    "/officialInvites/{tokenId}": {
      "schema": { "$ref": "#/entities/OfficialInvite" },
      "description": "Invite tokens issued by verified college officials for club leaders."
    },
    "/betaConfig/{configId}": {
      "schema": { "$ref": "#/entities/BetaConfig" },
      "description": "Private 6-seat closed-beta toggle and capacity config managed by nvipuj@gmail.com."
    },
    "/betaSeats/{seatId}": {
      "schema": { "$ref": "#/entities/BetaSeat" },
      "description": "Approved Google account beta seats keyed by SHA-256 email hash."
    },
    "/betaInviteCodes/{codeId}": {
      "schema": { "$ref": "#/entities/BetaInviteCode" },
      "description": "One-time access codes issued by Campus Official for regular student beta testers."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CampusEvent" },
      "description": "Campus events synced across devices and Cloud Run container restarts."
    },
    "/registrations/{regId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Student event registrations and check-in statuses scoped to registrant and institution officials."
    },
    "/announcements/{annId}": {
      "schema": { "$ref": "#/entities/CampusAnnouncement" },
      "description": "Pinned institutional announcements authored by verified Campus Officials."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Targeted event and approval notifications scoped strictly to recipientUid/recipientEmail or sender."
    },
    "/partnerPosts/{postId}": {
      "schema": { "$ref": "#/entities/PartnerPost" },
      "description": "Discoverable builder availability posts scoped by owner write access."
    },
    "/squads/{squadId}": {
      "schema": { "$ref": "#/entities/Squad" },
      "description": "Formed event squads scoped strictly to memberIds for private details and ownerId for management."
    },
    "/connectionRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ConnectionRequest" },
      "description": "Private 1-on-1 connection requests visible strictly to sender or recipient."
    },
    "/joinRequests/{requestId}": {
      "schema": { "$ref": "#/entities/SquadJoinRequest" },
      "description": "Squad join requests visible strictly to applicant or squad owner."
    },
    "/teamUpCalls/{callId}": {
      "schema": { "$ref": "#/entities/TeamUpCall" },
      "description": "Targeted Team-up Calls visible strictly to creator or matched recipientUserIds."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/TeamConversation" },
      "description": "Private 1-on-1 conversations visible strictly to participantIds."
    },
    "/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/TeamChatMessage" },
      "description": "Chat messages scoped strictly to participantIds on each message."
    },
    "/registrationSnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/SquadRegistrationSnapshot" },
      "description": "Squad registration roster snapshots visible strictly to squad memberIds."
    },
    "/eventFeedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/EventFeedback" },
      "description": "Student feedback submissions for campus events."
    },
    "/surveys/{surveyId}": {
      "schema": { "$ref": "#/entities/CampusSurvey" },
      "description": "Campus-wide feedback surveys authored by Campus Officials."
    },
    "/surveyResponses/{responseId}": {
      "schema": { "$ref": "#/entities/SurveyResponse" },
      "description": "Student responses to campus surveys."
    }
  }
}
