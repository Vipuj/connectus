          "type": "string",
          "maxLength": 140
        },
        "bio": {
          "type": "string",
          "maxLength": 300
        },
        "graduationYear": {
          "type": "string",
          "maxLength": 16
        },
        "rollNumber": {
          "type": "string",
          "maxLength": 40
        },
        "linkedinUrl": {
          "type": "string",
          "maxLength": 200
        },
        "githubUrl": {
          "type": "string",
          "maxLength": 200
        },
        "portfolioUrl": {
          "type": "string",
          "maxLength": 200
        },
        "leetcodeUrl": {
          "type": "string",
          "maxLength": 200
        },
        "hackerrankUrl": {
          "type": "string",
          "maxLength": 200
        },
        "instagramUrl": {
          "type": "string",
          "maxLength": 200
        },
        "savedEventIds": {
          "type": "string",
          "description": "Bounded list of up to 100 saved event IDs."
        },
        "mutedAll": {
          "type": "boolean"
        },
        "telegramConnected": {
          "type": "boolean"
        },
        "telegramHandle": {
          "type": "string",
          "maxLength": 64
        },
        "telegramChatId": {
          "type": "string",
          "maxLength": 64
        },
        "quietHours": {
          "type": "object",
          "description": "IST quiet hours configuration (enabled, start, end)."
        },
        "profileVisibility": {
          "type": "object",
          "description": "Student visibility defaults (linksVisibility, discoverableInTeams, showAcademicYear)."
        },
        "accessibilityPrefs": {
          "type": "object",
          "description": "Appearance and accessibility toggles (reducedMotion, highContrastFocus, compactDensity, themePreference: system|light|dark)."
        },
        "preferredModes": {
          "type": "string",
          "description": "Bounded list of up to 3 preferred event delivery modes."
        },
        "availability": {
          "type": "string",
          "enum": ["Weekends", "Evenings", "Open to All"]
