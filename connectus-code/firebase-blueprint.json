        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "eventId", "participantIds", "status", "createdAt", "updatedAt"]
    },
    "TeamChatMessage": {
      "title": "TeamChatMessage",
      "description": "Private message belonging to a TeamConversation or Squad room.",
      "type": "object",
      "properties": {
