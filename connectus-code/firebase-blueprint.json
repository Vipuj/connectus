          "type": "string",
          "enum": ["woman", "man", "non_binary", "prefer_not_to_say", "unset"]
        },
        "languages": {
          "type": "string",
          "description": "Bounded list of up to 5 spoken language strings from the Connectus allowlist."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
