        "rolesNeeded": { "type": "string", "description": "Bounded list of up to 10 roles." },
        "preferredAreas": { "type": "string", "description": "Bounded list of up to 16 corridor area IDs." },
        "preferredLanguages": { "type": "string", "description": "Bounded list of up to 10 spoken languages." },
        "genderPreference": { "type": "string", "enum": ["any", "woman", "man", "non_binary"] },
        "audienceMode": { "type": "string", "enum": ["active_only", "all_matching"] },
        "note": { "type": "string", "maxLength": 300 },
        "eligibleCount": { "type": "number" },
        "recipientUserIds": { "type": "string", "description": "Bounded list of up to 50 recipient UIDs." },
        "status": { "type": "string", "enum": ["active", "closed", "expired"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "eventId", "creatorId", "teammatesNeeded", "status", "createdAt", "updatedAt"]
    },
    "TeamConversation": {
      "title": "TeamConversation",
      "description": "Private 1-on-1 teammate introduction chat with mutual confirmation prior to squad creation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventId": { "type": "string", "maxLength": 128 },
        "participantIds": { "type": "string", "description": "Bounded list of exactly 2 UIDs." },
        "confirmedByUserIds": { "type": "string", "description": "Bounded list of confirming UIDs." },
        "status": { "type": "string", "enum": ["active", "confirmed_to_squad", "archived"] },
