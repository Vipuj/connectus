      },
      "required": ["id", "squadId", "eventId", "submittedByUserId", "memberIds", "status", "rosterHash", "submittedAt"]
    },
    "EventFeedback": {
      "title": "EventFeedback",
      "description": "Participant rating, review, suggestion, and complaint for a campus event.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
