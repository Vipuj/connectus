        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "roomId", "roomScope", "senderId", "kind", "body", "participantIds", "createdAt"]
    },
    "SquadRegistrationSnapshot": {
      "title": "SquadRegistrationSnapshot",
      "description": "Immutable event registration roster snapshot for a locked squad.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "squadId": { "type": "string", "maxLength": 128 },
        "eventId": { "type": "string", "maxLength": 128 },
        "submittedByUserId": { "type": "string", "maxLength": 128 },
        "memberIds": { "type": "string", "description": "Bounded list of up to 10 member UIDs." },
