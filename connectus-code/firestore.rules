            exists(/databases/$(database)/documents/officialInvites/$(request.resource.data.inviteToken)) &&
            get(/databases/$(database)/documents/officialInvites/$(request.resource.data.inviteToken)).data.status == 'active' &&
            get(/databases/$(database)/documents/officialInvites/$(request.resource.data.inviteToken)).data.collegeId == incoming().collegeId &&
            get(/databases/$(database)/documents/officialInvites/$(request.resource.data.inviteToken)).data.usedCount < get(/databases/$(database)/documents/officialInvites/$(request.resource.data.inviteToken)).data.maxUses
          )
        );
      allow update: if isValidId(userId) &&
        isValidOfficialMembership(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().collegeId == existing().collegeId &&
        incoming().memberRole == existing().memberRole &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isBetaManager() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['clubName', 'contactName', 'designation', 'status', 'updatedAt'])
          ) ||
          (
            isApprovedCollegeOfficial(existing().collegeId) &&
            existing().memberRole == 'club_leader' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            isOwner(userId) &&
            existing().status == 'approved' &&
            incoming().status == 'approved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['clubName', 'contactName', 'designation', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && (
        isBetaManager() ||
        (isOwner(userId) && existing().email == 'vipujgaming@gmail.com')
      );
    }

    match /officialInvites/{tokenId} {
      allow get: if isValidId(tokenId) && isSignedIn();
      allow list: if isBetaManager() || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow create: if isValidId(tokenId) &&
        isValidOfficialInvite(incoming(), tokenId) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().status == 'active' &&
        incoming().usedCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isBetaManager() || isApprovedCollegeOfficial(incoming().collegeId));
      allow update: if isValidId(tokenId) &&
        isValidOfficialInvite(incoming(), tokenId) &&
        incoming().token == existing().token &&
        incoming().code == existing().code &&
        incoming().collegeId == existing().collegeId &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isBetaManager() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedCount', 'updatedAt'])
          ) ||
          (
            isApprovedCollegeOfficial(existing().collegeId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            isSignedIn() &&
            existing().status == 'active' &&
            existing().usedCount < existing().maxUses &&
            incoming().usedCount == existing().usedCount + 1 &&
            incoming().status in ['active', 'used'] &&
            (!('targetEmail' in existing()) || existing().targetEmail == '' || existing().targetEmail == request.auth.token.email) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['usedCount', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(tokenId) && isBetaManager();
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (
        resource == null ||
        isBetaManager() ||
        resource.data.status in ['published', 'cancelled'] ||
        resource.data.ownerUid == request.auth.uid ||
        isApprovedCollegeOfficial(resource.data.collegeId)
      );
      allow list: if isSignedIn() && (
        isBetaManager() ||
        resource.data.status in ['published', 'cancelled'] ||
        resource.data.ownerUid == request.auth.uid
      );
      allow create: if isValidId(eventId) &&
        isSignedIn() &&
        isValidCampusEvent(incoming(), eventId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isBetaManager() ||
          isApprovedCollegeOfficial(incoming().collegeId) ||
          (isApprovedClubLeader(incoming().collegeId) && incoming().status in ['draft', 'pending_review'])
        );
      allow update: if isValidId(eventId) &&
        isSignedIn() &&
        isValidCampusEvent(incoming(), eventId) &&
        incoming().id == existing().id &&
        incoming().clubId == existing().clubId &&
        incoming().collegeId == existing().collegeId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            (isBetaManager() || isApprovedCollegeOfficial(existing().collegeId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'type', 'startAt', 'endAt', 'venueName', 'areaId',
              'placeId', 'formattedAddress', 'lat', 'lng', 'mode', 'audience', 'regStatus',
              'branches', 'years', 'feeInr', 'capacity', 'confirmedCount', 'waitlistCount',
              'regDeadline', 'regLink', 'googleFormUrl', 'whatsappGroupUrl', 'telegramGroupUrl',
              'paymentInfo', 'rules', 'teamSize', 'prizesAndPerks', 'prerequisites', 'coordinatorContact',
              'posterUrl', 'additionalPosterUrls', 'promoVideoUrl', 'promoVideoCaption', 'sourceType', 'isSponsored', 'sponsorLabel',
              'submissionFeedback', 'approvedById', 'approvedByName', 'pendingRevision',
              'revisionPendingReview', 'approvalHistory', 'status', 'changeNotice', 'updatedAt'
            ])
          ) ||
          (
            isApprovedClubLeader(existing().collegeId) &&
            existing().ownerUid == request.auth.uid &&
            incoming().status in ['draft', 'pending_review', 'changes_requested', 'published'] &&
            (incoming().status != 'published' || existing().status == 'published') &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'type', 'startAt', 'endAt', 'venueName', 'areaId',
              'placeId', 'formattedAddress', 'lat', 'lng', 'mode', 'audience', 'regStatus',
              'branches', 'years', 'feeInr', 'capacity', 'regDeadline', 'regLink',
              'googleFormUrl', 'whatsappGroupUrl', 'telegramGroupUrl', 'paymentInfo',
              'rules', 'teamSize', 'prizesAndPerks', 'prerequisites', 'coordinatorContact',
              'posterUrl', 'additionalPosterUrls', 'promoVideoUrl', 'promoVideoCaption', 'submissionFeedback',
